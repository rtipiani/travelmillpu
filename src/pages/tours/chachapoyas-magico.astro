---
import Layout from "../../layouts/Layout.astro";
import NavbarMillpu from "../../components/NavbarMillpu.astro";
import Footer from "../../components/Footer.astro";
---

<Layout 
    title="Chachapoyas Mágico 4D/3N | Travel Millpu" 
    description="Vive una experiencia completa en Chachapoyas con este paquete de 4 días. Visita Kuélap, Gocta, los Sarcófagos de Karajia y la Ruta de los Cañones."
>
    <NavbarMillpu />

    <!-- Hero Header: CLEAN AND CINEMATIC -->
    <header class="relative w-full h-[60vh] min-h-[500px] flex flex-col items-center justify-center overflow-hidden">
        <img 
            src="/images/chachapoyas_magico.png" 
            alt="Chachapoyas Mágico" 
            class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/30"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-transparent to-black/40"></div>
        
        <div class="relative z-10 text-center px-4 max-w-4xl mx-auto mt-24">
            <span class="inline-block py-1.5 px-4 rounded-full bg-white/20 backdrop-blur-md border border-white/40 text-white text-xs font-bold tracking-[0.2em] uppercase mb-6">
                Paquete Exclusivo
            </span>
            <h1 class="text-6xl md:text-8xl font-Yesteryear text-white mb-4 drop-shadow-md">
                Chachapoyas Mágico
            </h1>
            <p class="text-lg md:text-2xl text-white/90 font-light tracking-[0.3em] uppercase drop-shadow-sm">
                4 Días de Historia y Naturaleza
            </p>
        </div>
    </header>

    <!-- Main Content Background -->
    <div class="bg-white">
        <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
            
            <!-- Left Column: Content -->
            <div class="lg:col-span-8 space-y-20">
                
                <!-- Introduction -->
                <section class="max-w-3xl">
                    <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 tracking-tight mb-6">
                        Una Inmersión Profunda en el <span class="text-primary">Reino de las Nubes</span>.
                    </h2>
                    <div class="prose prose-lg text-gray-600">
                        <p class="text-xl font-medium text-gray-800 leading-relaxed mb-4">
                            Chachapoyas Mágico es nuestra propuesta más completa para quienes desean absorber cada rincón de esta región ancestral.
                        </p>
                        <p class="leading-relaxed">
                            Desde la imponente fortaleza de Kuélap hasta los enigmáticos Sarcófagos de Karajia, este viaje de 4 días te llevará por paisajes que parecen detenidos en el tiempo. Disfruta de la comodidad de un servicio planificado al detalle, donde la aventura se mezcla con la mística de una de las culturas más fascinantes del Perú.
                        </p>
                    </div>
                </section>

                <!-- Itinerary Timeline -->
                <section>
                    <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 tracking-tight mb-10">
                        Itinerario <span class="text-primary">Detallado</span>.
                    </h2>
                    
                    <div class="flex flex-col gap-10">
                        
                        <!-- Día 1 -->
                        <div class="group">
                            <div class="flex items-center gap-4 mb-6">
                                <div class="w-12 h-12 rounded-full bg-gray-900 text-white flex items-center justify-center font-bold text-lg shrink-0">
                                    D1
                                </div>
                                <h3 class="text-2xl font-bold text-gray-900">Fortaleza Kuélap y Teleférico</h3>
                            </div>
                            
                            <div class="grid md:grid-cols-2 gap-8 ml-4 md:ml-16">
                                <div class="rounded-2xl overflow-hidden shadow-sm h-64 border border-gray-100">
                                    <img src="/images/kuelap.avif" alt="Kuélap" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                                </div>
                                <ul class="space-y-4 text-gray-600 self-center">
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-gray-400 mt-1 mr-4 text-sm w-4"></i>
                                        <span>Recojo de su hotel (Cerca de la ciudad)</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-gray-400 mt-1 mr-4 text-sm w-4"></i>
                                        <span>Movilidad en servicio compartido</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-gray-400 mt-1 mr-4 text-sm w-4"></i>
                                        <span>Traslado en telecabinas Kuélap (ida y retorno)</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-gray-400 mt-1 mr-4 text-sm w-4"></i>
                                        <span>Ingreso y Visita guiada a la Ciudadela de Kuélap</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-gray-400 mt-1 mr-4 text-sm w-4"></i>
                                        <span>Almuerzo en restaurante campestre (platos seleccionados)</span>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <!-- Día 2 -->
                        <div class="group border-t border-gray-100 pt-10">
                            <div class="flex items-center gap-4 mb-6">
                                <div class="w-12 h-12 rounded-full bg-gray-900 text-white flex items-center justify-center font-bold text-lg shrink-0">
                                    D2
                                </div>
                                <h3 class="text-2xl font-bold text-gray-900">Catarata de Gocta</h3>
                            </div>
                            
                            <div class="grid md:grid-cols-2 gap-8 ml-4 md:ml-16">
                                <div class="rounded-2xl overflow-hidden shadow-sm h-64 border border-gray-100">
                                    <img src="/images/gocta.avif" alt="Gocta" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                                </div>
                                <ul class="space-y-4 text-gray-600 self-center">
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-gray-400 mt-1 mr-4 text-sm w-4"></i>
                                        <span>Recojo del hotel y traslado a Cocachimba</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-gray-400 mt-1 mr-4 text-sm w-4"></i>
                                        <span>Caminata guiada hacia la impresionante catarata</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-gray-400 mt-1 mr-4 text-sm w-4"></i>
                                        <span>Tickets de entrada incluidos</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-gray-400 mt-1 mr-4 text-sm w-4"></i>
                                        <span>Almuerzo en el poblado de Cocachimba</span>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <!-- Día 3 -->
                        <div class="group border-t border-gray-100 pt-10">
                            <div class="flex items-center gap-4 mb-6">
                                <div class="w-12 h-12 rounded-full bg-gray-900 text-white flex items-center justify-center font-bold text-lg shrink-0">
                                    D3
                                </div>
                                <h3 class="text-2xl font-bold text-gray-900">Sarcófagos de Karajia y Caverna Quiocta</h3>
                            </div>
                            
                            <div class="grid md:grid-cols-2 gap-8 ml-4 md:ml-16">
                                <div class="rounded-2xl overflow-hidden shadow-sm h-64 border border-gray-100">
                                    <img src="/images/karajia.png" alt="Sarcófagos de Karajia" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                                </div>
                                <ul class="space-y-4 text-gray-600 self-center">
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-gray-400 mt-1 mr-4 text-sm w-4"></i>
                                        <span>Visita a los enigmáticos sarcófagos antropomorfos</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-gray-400 mt-1 mr-4 text-sm w-4"></i>
                                        <span>Exploración de la fascinante Caverna de Quiocta</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-gray-400 mt-1 mr-4 text-sm w-4"></i>
                                        <span>Almuerzo en Lamud - Luya</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-gray-400 mt-1 mr-4 text-sm w-4"></i>
                                        <span>Todos los tickets de ingreso incluidos</span>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <!-- Día 4 -->
                        <div class="group border-t border-gray-100 pt-10">
                            <div class="flex items-center gap-4 mb-6">
                                <div class="w-12 h-12 rounded-full bg-gray-900 text-white flex items-center justify-center font-bold text-lg shrink-0">
                                    D4
                                </div>
                                <h3 class="text-2xl font-bold text-gray-900">Ruta de los Cañones</h3>
                            </div>
                            
                            <div class="grid md:grid-cols-2 gap-8 ml-4 md:ml-16">
                                <div class="rounded-2xl overflow-hidden shadow-sm h-64 border border-gray-100">
                                    <img src="/images/canones.avif" alt="Cañones" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                                </div>
                                <ul class="space-y-4 text-gray-600 self-center">
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-gray-400 mt-1 mr-4 text-sm w-4"></i>
                                        <span>Cañón del Sonche y Mirador de Huanca Urco</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-gray-400 mt-1 mr-4 text-sm w-4"></i>
                                        <span>Vista panorámica desde el Mirador de Luya Urco</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-gray-400 mt-1 mr-4 text-sm w-4"></i>
                                        <span>Almuerzo turístico (plato a elección)</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-gray-400 mt-1 mr-4 text-sm w-4"></i>
                                        <span>Transporte turístico y ticket de ingreso</span>
                                    </li>
                                </ul>
                            </div>
                        </div>

                    </div>
                </section>

                <!-- Inclusions & Exclusions -->
                <section class="grid md:grid-cols-2 gap-8">
                    <!-- Incluye -->
                    <div class="bg-emerald-50/50 rounded-2xl p-8 border border-emerald-100">
                        <h3 class="text-lg font-bold text-gray-900 mb-6 flex items-center gap-3">
                            <i class="fas fa-check text-emerald-600"></i>
                            El Tour Incluye
                        </h3>
                        <ul class="space-y-4 text-sm text-gray-600">
                            <li class="flex items-start">
                                <span class="text-emerald-500 mr-3 mt-1.5"><i class="fas fa-circle text-[6px]"></i></span>
                                3 noches de alojamiento.
                            </li>
                            <li class="flex items-start">
                                <span class="text-emerald-500 mr-3 mt-1.5"><i class="fas fa-circle text-[6px]"></i></span>
                                3 desayunos y 3 almuerzos.
                            </li>
                            <li class="flex items-start">
                                <span class="text-emerald-500 mr-3 mt-1.5"><i class="fas fa-circle text-[6px]"></i></span>
                                Recojo del alojamiento para tours diarios.
                            </li>
                            <li class="flex items-start">
                                <span class="text-emerald-500 mr-3 mt-1.5"><i class="fas fa-circle text-[6px]"></i></span>
                                Tours guiados a Kuelap, Gocta, Karajía y Cañones.
                            </li>
                            <li class="flex items-start">
                                <span class="text-emerald-500 mr-3 mt-1.5"><i class="fas fa-circle text-[6px]"></i></span>
                                Tickets de ingreso y Telecabinas Kuélap.
                            </li>
                        </ul>
                    </div>

                    <!-- No Incluye -->
                    <div class="bg-red-50/50 rounded-2xl p-8 border border-red-100">
                        <h3 class="text-lg font-bold text-gray-900 mb-6 flex items-center gap-3">
                            <i class="fas fa-times text-red-500"></i>
                            No Incluye
                        </h3>
                        <ul class="space-y-4 text-sm text-gray-600">
                            <li class="flex items-start">
                                <span class="text-red-400 mr-3 mt-1.5"><i class="fas fa-circle text-[6px]"></i></span>
                                Aquellos no mencionados.
                            </li>
                            <li class="flex items-start">
                                <span class="text-red-400 mr-3 mt-1.5"><i class="fas fa-circle text-[6px]"></i></span>
                                Propinas y gastos personales.
                            </li>
                        </ul>
                    </div>
                </section>

            </div>

            <!-- Right Column: Sidebar -->
            <aside class="lg:col-span-4">
                <div class="sticky top-32 space-y-8">
                    
                    <!-- Pricing Card -->
                    <div class="bg-white rounded-2xl p-8 shadow-[0_8px_30px_rgba(0,0,0,0.06)] border border-gray-200">
                        <p class="text-xs font-bold text-gray-500 uppercase tracking-[0.2em] mb-4">Precio del Paquete</p>
                        <div class="flex items-baseline gap-2 mb-2">
                            <span class="text-2xl font-medium text-gray-900">S/</span>
                            <span class="text-5xl font-black text-gray-900 tracking-tighter">735</span>
                            <span class="text-xl font-bold text-gray-400">.00</span>
                        </div>
                        <div class="flex items-center gap-2 mb-8">
                            <span class="text-sm font-medium text-gray-500">Por persona / Mínimo 2 pax</span>
                        </div>

                        <div class="space-y-4 border-t border-gray-100 pt-6 mb-8">
                            <div class="flex items-center justify-between text-gray-600 text-sm">
                                <span class="flex items-center gap-2"><i class="far fa-clock w-4 text-center"></i> Duración</span>
                                <span class="font-bold text-gray-900">4 Días / 3 Noches</span>
                            </div>
                            <div class="flex items-center justify-between text-gray-600 text-sm">
                                <span class="flex items-center gap-2"><i class="fas fa-bed w-4 text-center"></i> Alojamiento</span>
                                <span class="font-bold text-gray-900">Incluido</span>
                            </div>
                        </div>
                        
                        <a 
                            href="https://wa.me/51969188876?text=¡Hola!,%20*Travel%20Millpu*%20estoy%20interesado%20en%20el%20paquete%20*CHACHAPOYAS%20MÁGICO%204D%2F3N*." 
                            target="_blank" 
                            rel="noopener noreferrer"
                            class="w-full flex items-center justify-center gap-2 px-6 py-4 bg-primary text-white text-sm font-bold rounded-xl hover:bg-red-700 transition-all shadow-md hover:shadow-xl"
                        >
                            Consultar Ahora
                            <i class="fab fa-whatsapp text-lg"></i>
                        </a>
                    </div>

                </div>
            </aside>

        </main>
    </div>

    <Footer />
</Layout>
