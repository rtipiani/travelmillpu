---
import Layout from "../../layouts/Layout.astro";
import NavbarMillpu from "../../components/NavbarMillpu.astro";
import Footer from "../../components/Footer.astro";
---

<Layout 
    title="Descubre Arequipa 4D/3N | Travel Millpu" 
    description="Explora la Ciudad Blanca de Arequipa en 4 días. Incluye City Tour o Ruta del Sillar, Cañón del Colca y Reserva Nacional Salinas y Aguada Blanca."
>
    <NavbarMillpu />

    <!-- Hero Header -->
    <header class="relative w-full h-[60vh] min-h-[500px] flex flex-col items-center justify-center overflow-hidden">
        <img 
            src="/images/sillar.avif" 
            alt="Descubre Arequipa" 
            class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/30"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-transparent to-black/40"></div>
        
        <div class="relative z-10 text-center px-4 max-w-4xl mx-auto mt-24">
            <span class="inline-block py-1.5 px-4 rounded-full bg-white/20 backdrop-blur-md border border-white/40 text-white text-xs font-bold tracking-[0.2em] uppercase mb-6">
                Experiencia Completa
            </span>
            <h1 class="text-6xl md:text-8xl font-Yesteryear text-white mb-4 drop-shadow-md">
                Descubre Arequipa
            </h1>
            <p class="text-lg md:text-2xl text-white/90 font-light tracking-[0.3em] uppercase drop-shadow-sm">
                4 Días en la Ciudad Blanca
            </p>
        </div>
    </header>

    <!-- Main Content -->
    <div class="bg-white">
        <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
            
            <div class="lg:col-span-8 space-y-20">
                
                <!-- Introduction -->
                <section class="max-w-3xl">
                    <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 tracking-tight mb-6">
                        La Esencia de los <span class="text-primary">Volcanes</span>.
                    </h2>
                    <div class="prose prose-lg text-gray-600">
                        <p class="text-xl font-medium text-gray-800 leading-relaxed mb-4">
                            Descubre Arequipa es un paquete diseñado para sumergirte en la belleza arquitectónica, natural y cultural de la región.
                        </p>
                        <p class="leading-relaxed">
                            Desde el blanco sillar de sus canteras y casonas coloniales hasta la profundidad del Cañón del Colca y la serenidad de la Reserva Nacional Salinas y Aguada Blanca. Un viaje de 4 días que combina historia, paisajes volcánicos y encuentros con la fauna andina.
                        </p>
                    </div>
                </section>

                <!-- Itinerary Timeline -->
                <section>
                    <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 tracking-tight mb-10">
                        Itinerario <span class="text-primary">Día a Día</span>.
                    </h2>
                    
                    <div class="flex flex-col gap-10">
                        
                        <!-- Día 1 -->
                        <div class="group">
                            <div class="flex items-center gap-4 mb-6">
                                <div class="w-12 h-12 rounded-full bg-gray-900 text-white flex items-center justify-center font-bold text-lg shrink-0">
                                    D1
                                </div>
                                <div class="flex flex-col">
                                    <h3 class="text-2xl font-bold text-gray-900">City Tour Campiña o Ruta del Sillar</h3>
                                    <span class="text-sm font-medium text-primary uppercase tracking-wider">A elegir una opción</span>
                                </div>
                            </div>
                            <div class="grid md:grid-cols-2 gap-8 ml-4 md:ml-16">
                                <div class="rounded-2xl overflow-hidden shadow-sm h-64 border border-gray-100">
                                    <img src="/images/sillar.avif" alt="City Tour Arequipa" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                                </div>
                                <div class="space-y-4">
                                    <p class="text-gray-600 text-sm">
                                        <strong class="text-gray-900">Opción A (Campiña):</strong> Visita a Yanahuara, Carmen Alto, Incalpaca, Mansión del Fundador y Molino de Sabandía.
                                    </p>
                                    <p class="text-gray-600 text-sm">
                                        <strong class="text-gray-900">Opción B (Sillar):</strong> Explora las canteras de Añashuayco, vive el proceso de extracción y visita la Quebrada de Culebrillas con sus petroglifos.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Día 2 -->
                        <div class="group border-t border-gray-100 pt-10">
                            <div class="flex items-center gap-4 mb-6">
                                <div class="w-12 h-12 rounded-full bg-gray-900 text-white flex items-center justify-center font-bold text-lg shrink-0">
                                    D2
                                </div>
                                <h3 class="text-2xl font-bold text-gray-900">Cañón del Colca Full Day</h3>
                            </div>
                            <div class="grid md:grid-cols-2 gap-8 ml-4 md:ml-16">
                                <div class="rounded-2xl overflow-hidden shadow-sm h-64 border border-gray-100">
                                    <img src="/images/colca.avif" alt="Cañón del Colca" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                                </div>
                                <ul class="space-y-3 text-gray-600 text-sm self-center">
                                    <li>Salida de madrugada hacia el valle del Colca.</li>
                                    <li>Cruz del Cóndor para observar el vuelo del ave sagrada.</li>
                                    <li>Visita a pueblos tradicionales (Maca, Yanque).</li>
                                    <li>Relajo en los baños termales de Chacapi.</li>
                                    <li>Observación de camélidos en la Reserva Nacional Salinas.</li>
                                </ul>
                            </div>
                        </div>

                        <!-- Día 3 -->
                        <div class="group border-t border-gray-100 pt-10">
                            <div class="flex items-center gap-4 mb-6">
                                <div class="w-12 h-12 rounded-full bg-gray-900 text-white flex items-center justify-center font-bold text-lg shrink-0">
                                    D3
                                </div>
                                <h3 class="text-2xl font-bold text-gray-900">Reserva Salinas y Aguada Blanca</h3>
                            </div>
                            <div class="grid md:grid-cols-2 gap-8 ml-4 md:ml-16">
                                <div class="rounded-2xl overflow-hidden shadow-sm h-64 border border-gray-100">
                                    <img src="/images/volcan.avif" alt="Salinas" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                                </div>
                                <ul class="space-y-3 text-gray-600 text-sm self-center">
                                    <li>Mirador de volcanes (Misti, Chachani, Pichu Pichu).</li>
                                    <li>Avistamiento de flamencos y fauna andina.</li>
                                    <li>Caminata por el salar y mini volcán de Lojen.</li>
                                    <li>Visita al pueblo tradicional de Chiguata.</li>
                                </ul>
                            </div>
                        </div>

                        <!-- Día 4 -->
                        <div class="group border-t border-gray-100 pt-10">
                            <div class="flex items-center gap-4 mb-6">
                                <div class="w-12 h-12 rounded-full bg-gray-900 text-white flex items-center justify-center font-bold text-lg shrink-0">
                                    D4
                                </div>
                                <h3 class="text-2xl font-bold text-gray-900">Día Libre y Despedida</h3>
                            </div>
                            <div class="grid md:grid-cols-2 gap-8 ml-4 md:ml-16">
                                <div class="bg-gray-50 rounded-2xl p-6 flex items-center justify-center border border-gray-100">
                                    <p class="text-gray-500 text-center italic">Tiempo libre para compras y exploración personal.</p>
                                </div>
                                <ul class="space-y-3 text-gray-600 text-sm self-center">
                                    <li>Mañana libre para disfrutar de la ciudad a tu ritmo.</li>
                                    <li>Oportunidad para visitar museos o mercados tradicionales.</li>
                                    <li>Coordinación de traslados finales.</li>
                                </ul>
                            </div>
                        </div>

                    </div>
                </section>

                <!-- Inclusions & Exclusions -->
                <section class="grid md:grid-cols-2 gap-8">
                    <div class="bg-emerald-50/50 rounded-2xl p-8 border border-emerald-100">
                        <h3 class="text-lg font-bold text-gray-900 mb-6 flex items-center gap-3">
                            <i class="fas fa-check text-emerald-600"></i>
                            El Tour Incluye
                        </h3>
                        <ul class="space-y-4 text-sm text-gray-600">
                            <li>Reunión informativa previa.</li>
                            <li>Transporte turístico en servicio compartido.</li>
                            <li>Guía oficial de turismo.</li>
                            <li>3 noches de alojamiento con desayunos.</li>
                        </ul>
                    </div>
                    <div class="bg-red-50/50 rounded-2xl p-8 border border-red-100">
                        <h3 class="text-lg font-bold text-gray-900 mb-6 flex items-center gap-3">
                            <i class="fas fa-times text-red-500"></i>
                            No Incluye
                        </h3>
                        <ul class="space-y-4 text-sm text-gray-600">
                            <li>Almuerzos y cenas.</li>
                            <li>Tickets de ingreso a atractivos.</li>
                            <li>Gastos personales.</li>
                        </ul>
                    </div>
                </section>

            </div>

            <!-- Sidebar -->
            <aside class="lg:col-span-4">
                <div class="sticky top-32 space-y-8">
                    <div class="bg-white rounded-2xl p-8 shadow-[0_8px_30px_rgba(0,0,0,0.06)] border border-gray-200">
                        <p class="text-xs font-bold text-gray-500 uppercase tracking-[0.2em] mb-4">Precio del Paquete</p>
                        <div class="flex items-baseline gap-2 mb-2">
                            <span class="text-2xl font-medium text-gray-900">S/</span>
                            <span class="text-5xl font-black text-gray-900 tracking-tighter">390</span>
                            <span class="text-xl font-bold text-gray-400">.00</span>
                        </div>
                        <div class="flex items-center gap-2 mb-8">
                            <span class="text-sm font-medium text-gray-500">Por persona / Mínimo 2 pax</span>
                        </div>
                        <div class="space-y-4 border-t border-gray-100 pt-6 mb-8">
                            <div class="flex items-center justify-between text-gray-600 text-sm">
                                <span class="flex items-center gap-2"><i class="far fa-clock w-4 text-center"></i> Duración</span>
                                <span class="font-bold text-gray-900">4 Días / 3 Noches</span>
                            </div>
                        </div>
                        <a 
                            href="https://wa.me/51969188876?text=¡Hola!,%20*Travel%20Millpu*%20estoy%20interesado%20en%20el%20paquete%20*DESCUBRE%20AREQUIPA%204D%2F3N*." 
                            target="_blank" 
                            rel="noopener noreferrer"
                            class="w-full flex items-center justify-center gap-2 px-6 py-4 bg-primary text-white text-sm font-bold rounded-xl hover:bg-red-700 transition-all shadow-md hover:shadow-xl"
                        >
                            Consultar Ahora
                            <i class="fab fa-whatsapp text-lg"></i>
                        </a>
                    </div>
                </div>
            </aside>

        </main>
    </div>

    <Footer />
</Layout>
