---
const tours = [
    {
        title: "DESCUBRE AREQUIPA 6D/5N",
        days: "6 DÍAS / 5 NOCHES",
        image: "/images/volcan.avif",
        description:
            "La expedición más completa. Disfruta de 6 días explorando el Cañón del Colca, la Laguna de Salinas, la Ruta del Sillar y tiempo libre para vivir la Ciudad Blanca a tu ritmo. Incluye 5 noches de hotel y desayunos.",
        link: "https://wa.me/51969188876?text=¡Hola!,%20*Travel%20Millpu*%20estoy%20interesado%20en%20el%20paquete%20*DESCUBRE%20AREQUIPA%206D%2F5N*.",
        itinerary: "/tours/arequipa-descubre-6d"
    },
    {
        title: "DESCUBRE AREQUIPA 5D/4N",
        days: "5 DÍAS / 4 NOCHES",
        image: "/images/colca.avif",
        description:
            "Aventura y cultura en 5 días. Conoce la Catarata de Pillones, el Cañón del Colca, la Reserva Nacional de Salinas y Aguada Blanca, y lo mejor del centro histórico de Arequipa.",
        link: "https://wa.me/51969188876?text=¡Hola!,%20*Travel%20Millpu*%20estoy%20interesado%20en%20el%20paquete%20*DESCUBRE%20AREQUIPA%205D%2F4N*.",
        itinerary: "/tours/arequipa-descubre-5d"
    },
    {
        title: "DESCUBRE AREQUIPA 4D/3N",
        days: "4 DÍAS / 3 NOCHES",
        image: "/images/sillar.avif",
        description:
            "La experiencia completa en la Ciudad Blanca. Disfruta de un city tour por la campiña o la ruta del sillar, explora la inmensidad del Cañón del Colca y maravíllate con la Reserva Nacional Salinas y Aguada Blanca. Incluye alojamiento y desayunos.",
        link: "https://wa.me/51969188876?text=¡Hola!,%20*Travel%20Millpu*%20estoy%20interesado%20en%20el%20paquete%20*DESCUBRE%20AREQUIPA%204D%2F3N*.",
        itinerary: "/tours/arequipa-descubre"
    },
    {
        title: "DESCUBRE AREQUIPA 3D/2N",
        days: "3 DÍAS / 2 NOCHES",
        image: "/images/chivay.avif",
        description:
            "Lo esencial de Arequipa en 3 días. Incluye una visita al Cañón del Colca, la Ruta del Sillar o la campiña arequipeña, y tiempo libre para disfrutar de la ciudad. Una escapada perfecta.",
        link: "https://wa.me/51969188876?text=¡Hola!,%20*Travel%20Millpu*%20estoy%20interesado%20en%20el%20paquete%20*DESCUBRE%20AREQUIPA%203D%2F2N*.",
        itinerary: "/tours/arequipa-descubre-3d"
    },
];
---

<section class="py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
            <h2
                class="text-4xl md:text-5xl font-extrabold text-gray-900 tracking-tight mb-4"
            >
                Vamos a conocer <span class="text-primary">Arequipa</span>.
            </h2>
            <p class="text-lg text-gray-500 max-w-2xl mx-auto">
                Descubre la magia de la Ciudad Blanca y sus impresionantes
                atractivos naturales.
            </p>
        </div>

        <div class="grid sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {
                tours.map((tour) => (
                    <div class="flex flex-col bg-white rounded-2xl shadow-sm hover:shadow-2xl transition-all duration-300 overflow-hidden border border-gray-200 h-full"
                    >
                        <div class="relative w-full h-[400px] overflow-hidden bg-gray-200 shrink-0">
                            <img
                                class="w-full h-full object-cover"
                                src={tour.image}
                                alt={tour.title}
                                loading="lazy"
                                decoding="async"
                            />
                            <div class="absolute top-4 right-4 bg-white/95 backdrop-blur-sm px-4 py-1.5 rounded-full text-xs font-black text-primary shadow-sm tracking-wide">
                                {tour.days}
                            </div>
                        </div>

                        <div class="flex flex-col justify-between p-6 h-full">
                            <div class="text-left mb-6">
                                <h3 class="text-lg font-bold text-gray-900 mb-2 line-clamp-2">
                                    {tour.title}
                                </h3>
                                <p class="text-sm text-gray-600 leading-relaxed line-clamp-3">
                                    {tour.description}
                                </p>
                            </div>

                            <div class="mt-auto flex flex-col gap-3">
                                {tour.itinerary && (
                                    <a href={tour.itinerary} class="w-full inline-flex items-center justify-center px-4 py-3 bg-gray-100 text-gray-800 text-sm font-bold rounded-xl hover:bg-gray-200 transition-all duration-300">
                                        Ver Itinerario
                                    </a>
                                )}
                                <a href={tour.link} target="_blank" rel="noopener noreferrer" class="w-full inline-flex items-center justify-center px-4 py-3 bg-primary text-white text-sm font-bold rounded-xl hover:bg-red-700 transition-all duration-300">
                                    Consultar Ahora
                                    <i class="fab fa-whatsapp ml-2 text-lg" aria-hidden="true" />
                                </a>
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
