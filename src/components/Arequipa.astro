---
const tours = [
    {
        title: "TOUR CAÑON DEL COLCA",
        days: "FULL DAY",
        image: "/images/colca.avif",
        description:
            "Embárcate en una aventura única hacia el Cañón del Colca, uno de los cañones más profundos del mundo. Disfruta de impresionantes paisajes montañosos, el avistamiento de cóndores y la inmersión en la cultura local de los pueblos andinos que habitan esta región. Ideal para los amantes de la naturaleza, la historia y la aventura, el tour te permitirá explorar este asombroso destino de una manera inolvidable.",
        link: "https://wa.me/51969188876?text=¡Hola!,%20*Travel%20Millpu*%20estoy%20interesado%20en%20el%20full%20day%20*TOUR%20CAÑON%20DEL%20COLCA*.",
    },
    {
        title: "CAÑON DEL COLCA + CHIVAY",
        days: "2 DÍAS / 1 NOCHE",
        image: "/images/chivay.avif",
        description:
            "Disfruta de una experiencia inolvidable combinando el impresionante Cañón del Colca con la pintoresca localidad de Chivay. Vive la emoción de explorar uno de los cañones más profundos del mundo, mientras observas a los majestuosos cóndores en su vuelo. Luego, relájate en las aguas termales de Chivay y conoce la riqueza cultural de esta región andina. Un destino ideal para los viajeros que buscan belleza natural, aventura y tradición en un solo viaje.",
        link: "https://wa.me/51969188876?text=¡Hola!,%20*Travel%20Millpu*%20estoy%20interesado%20en%20el%20paquete%20*CAÑON%20DEL%20COLCA%20%2B%20CHIVAY%202%20DÍAS%20%2F%201%20NOCHE*.",
    },
    {
        title: "RUTA DEL SILLAR",
        days: "MEDIO DÍA",
        image: "/images/sillar.avif",
        description:
            "Descubre la fascinante Ruta del Sillar, un recorrido por las canteras de donde se extrae la piedra volcánica blanca que da nombre a la 'Ciudad Blanca' de Arequipa. Admira las impresionantes esculturas talladas en sillar, conoce el proceso de extracción tradicional y maravíllate con los espectaculares cañones formados por esta piedra. Una experiencia cultural y paisajística única y obligatoria en Arequipa.",
        link: "https://wa.me/51969188876?text=¡Hola!,%20*Travel%20Millpu*%20estoy%20interesado%20en%20el%20tour%20*RUTA%20DEL%20SILLAR*.",
    },
];
---

<section class="py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
            <h2
                class="text-4xl md:text-5xl font-extrabold text-gray-900 tracking-tight mb-4"
            >
                Vamos a conocer <span class="text-primary">Arequipa</span>.
            </h2>
            <p class="text-lg text-gray-500 max-w-2xl mx-auto">
                Descubre la magia de la Ciudad Blanca y sus impresionantes
                atractivos naturales.
            </p>
        </div>

        <div class="grid sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {
                tours.map((tour) => (
                    <div class="flex flex-col bg-white rounded-2xl shadow-sm hover:shadow-2xl transition-all duration-300 overflow-hidden border border-gray-200 h-full"
                    >
                        <div class="relative w-full h-[400px] overflow-hidden bg-gray-200 shrink-0">
                            <img
                                class="w-full h-full object-cover"
                                src={tour.image}
                                alt={tour.title}
                                loading="lazy"
                                decoding="async"
                            />
                            <div class="absolute top-4 right-4 bg-white/95 backdrop-blur-sm px-4 py-1.5 rounded-full text-xs font-black text-primary shadow-sm tracking-wide">
                                {tour.days}
                            </div>
                        </div>

                        <div class="flex flex-col justify-between p-6 h-full">
                            <div class="text-left mb-6">
                                <h3 class="text-lg font-bold text-gray-900 mb-2 line-clamp-2">
                                    {tour.title}
                                </h3>
                                <p class="text-sm text-gray-600 leading-relaxed line-clamp-3">
                                    {tour.description}
                                </p>
                            </div>

                            <div class="mt-auto flex flex-col gap-3">
                                <a href="#" class="w-full inline-flex items-center justify-center px-4 py-3 bg-gray-100 text-gray-800 text-sm font-bold rounded-xl hover:bg-gray-200 transition-all duration-300">
                                    Ver Itinerario
                                </a>
                                <a href={tour.link} target="_blank" rel="noopener noreferrer" class="w-full inline-flex items-center justify-center px-4 py-3 bg-primary text-white text-sm font-bold rounded-xl hover:bg-red-700 transition-all duration-300">
                                    Consultar Ahora
                                    <i class="fab fa-whatsapp ml-2 text-lg" aria-hidden="true" />
                                </a>
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
