---
const pathname = Astro.url.pathname;
const navLinks = [
    { name: "Arequipa", href: "/arequipa" },
    { name: "Puno", href: "/puno" },
    { name: "Cusco", href: "/cusco" },
    { name: "Iquitos", href: "/iquitos" },
    { name: "Selva Central", href: "/selva-central" },
    { name: "Chachapoyas", href: "/chachapoyas" },
    { name: "Contáctanos", href: "/contacts" }
];
---
<nav id="navbar" class="w-full bg-transparent py-4 px-6 fixed top-0 left-0 z-50 transition-all duration-500">
    <div class="container mx-auto flex justify-between items-center">
        <div class="w-auto">
            <a href="/" aria-label="Inicio">
                <img 
                    src="/images/logomillpu.avif" 
                    alt="Logo" width="200" height="100"
                    class="h-12 lg:h-16 w-auto"
                >
            </a>
        </div>        

        <ul class="hidden md:flex space-x-6 text-base font-medium text-white">
            {navLinks.map((link) => {
                const isActive = pathname === link.href || pathname === link.href + '/' || (link.href !== '/' && pathname.includes(link.href.replace('/', '')));
                return (
                    <li>
                        <a 
                            href={link.href} 
                            class={`transition pb-1 ${isActive ? 'text-white font-bold border-b-2 border-primary' : 'text-gray-100 hover:text-white'}`}
                            aria-current={isActive ? 'page' : undefined}
                        >
                            {link.name}
                        </a>
                    </li>
                );
            })}
        </ul>

        <button id="menu-button" class="md:hidden text-white text-3xl" aria-label="Abrir menú">
            <i class="fas fa-bars"></i>
        </button>
    </div>

    <div id="mobile-menu" class="hidden absolute bg-black/90 backdrop-blur-lg w-full top-full left-0 border-t border-white/10">
        <ul class="flex flex-col space-y-4 py-6 px-4 text-center text-base text-white">
            {navLinks.map((link) => {
                const isActive = pathname === link.href || pathname === link.href + '/' || (link.href !== '/' && pathname.includes(link.href.replace('/', '')));
                return (
                    <li>
                        <a 
                            href={link.href} 
                            class={`transition block py-2 ${isActive ? 'text-primary font-bold border-l-4 border-primary pl-2' : 'hover:text-gray-300'}`}
                            aria-current={isActive ? 'page' : undefined}
                        >
                            {link.name}
                        </a>
                    </li>
                );
            })}
        </ul>
    </div>
</nav>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const navbar = document.getElementById('navbar');
        const menuButton = document.getElementById('menu-button');
        const mobileMenu = document.getElementById('mobile-menu');
        
        // Handle background change on scroll
        const handleScroll = () => {
            if (window.scrollY > 50) {
                navbar?.classList.add('bg-black/80', 'backdrop-blur-md', 'py-3', 'shadow-lg');
                navbar?.classList.remove('bg-transparent', 'py-4');
            } else {
                navbar?.classList.remove('bg-black/80', 'backdrop-blur-md', 'py-3', 'shadow-lg');
                navbar?.classList.add('bg-transparent', 'py-4');
            }
        };

        window.addEventListener('scroll', handleScroll);
        handleScroll(); // Initial check

        if (menuButton && mobileMenu) {
            menuButton.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });
        }
    });
</script>
