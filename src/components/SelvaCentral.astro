---
interface Tour {
    title: string;
    days: string;
    image: string;
    description: string;
    link: string;
    itinerary?: string;
}

const tours: Tour[] = [
    {
        title: "OXAPAMPA",
        days: "FULL DAY",
        image: "/images/oxapampa.avif",
        description:
            "Descubre la herencia austro-alemana en Oxapampa, recorre sus hermosos paisajes verdes, su arquitectura típica de madera y disfruta de su gastronomía y naturaleza.",
        link: "https://wa.me/51969188876?text=¡Hola!,%20*Travel%20Millpu*%20estoy%20interesado%20en%20el%20tour%20*OXAPAMPA*.",
    },
    {
        title: "POZUZO",
        days: "FULL DAY",
        image: "/images/pozuzo.avif",
        description:
            "Visita la única colonia austro-alemana en la selva del mundo. Explora sus cataratas, conoce sus tradiciones y prueba sus famosos quesos y cervezas artesanales.",
        link: "https://wa.me/51969188876?text=¡Hola!,%20*Travel%20Millpu*%20estoy%20interesado%20en%20el%20tour%20*POZUZO*.",
    },
    {
        title: "VILLA RICA",
        days: "FULL DAY",
        image: "/images/villarica.avif",
        description:
            "Conoce la capital cafetalera del Perú, donde podrás degustar el mejor café, visitar la famosa laguna El Oconal y aprender todo sobre el proceso del café peruano.",
        link: "https://wa.me/51969188876?text=¡Hola!,%20*Travel%20Millpu*%20estoy%20interesado%20en%20el%20tour%20*VILLA%20RICA*.",
    },
    {
        title: "CHANCHAMAYO",
        days: "FULL DAY",
        image: "/images/chanchamayo.avif",
        description:
            "Adéntrate en la selva viva, conoce comunidades nativas, disfruta de cataratas impresionantes y vive la experiencia directa con la naturaleza y fauna silvestre.",
        link: "https://wa.me/51969188876?text=¡Hola!,%20*Travel%20Millpu*%20estoy%20interesado%20en%20el%20tour%20*CHANCHAMAYO*.",
    },
    {
        title: "PERENÉ",
        days: "FULL DAY",
        image: "/images/perene.avif",
        description:
            "Navega por el imponente río Perené y asómbrate con las cascadas de Velo de Novia y Bayoz, un viaje de conexión total con la majestuosidad de la Amazonía.",
        link: "https://wa.me/51969188876?text=¡Hola!,%20*Travel%20Millpu*%20estoy%20interesado%20en%20el%20tour%20*PERENÉ*.",
    },
    {
        title: "LA FORTUNA",
        days: "FULL DAY",
        image: "/images/lafortuna.avif",
        description:
            "Una experiencia inmersiva en la naturaleza pura. Ideal para desconectarse de la rutina y maravillarse con los rincones más exóticos y tranquilos de la selva central.",
        link: "https://wa.me/51969188876?text=¡Hola!,%20*Travel%20Millpu*%20estoy%20interesado%20en%20el%20tour%20*LA%20FORTUNA*.",
    },
];
---

<section class="py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
            <h2
                class="text-4xl md:text-5xl font-extrabold text-gray-900 tracking-tight mb-4"
            >
                Vamos a conocer la <span class="text-primary"
                    >Selva Central</span
                >.
            </h2>
            <p class="text-lg text-gray-500 max-w-2xl mx-auto">
                Explora el paraíso natural del centro del Perú: café, cataratas,
                comunidades nativas y herencia cultural.
            </p>
        </div>

        <div class="grid sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {
                tours.map((tour) => (
                    <div class="flex flex-col bg-white rounded-2xl shadow-sm hover:shadow-2xl transition-all duration-300 overflow-hidden border border-gray-200 h-full"
                    >
                        <div class="relative w-full h-[400px] overflow-hidden bg-gray-200 shrink-0">
                            <img
                                class="w-full h-full object-cover"
                                src={tour.image}
                                alt={tour.title}
                                loading="lazy"
                                decoding="async"
                            />
                            <div class="absolute top-4 right-4 bg-white/95 backdrop-blur-sm px-4 py-1.5 rounded-full text-xs font-black text-primary shadow-sm tracking-wide">
                                {tour.days}
                            </div>
                        </div>

                        <div class="flex flex-col justify-between p-6 h-full">
                            <div class="text-left mb-6">
                                <h3 class="text-lg font-bold text-gray-900 mb-2 line-clamp-2">
                                    {tour.title}
                                </h3>
                                <p class="text-sm text-gray-600 leading-relaxed line-clamp-3">
                                    {tour.description}
                                </p>
                            </div>

                            <div class="mt-auto flex flex-col gap-3">
                                {tour.itinerary && (
                                    <a href={tour.itinerary} class="w-full inline-flex items-center justify-center px-4 py-3 bg-gray-100 text-gray-800 text-sm font-bold rounded-xl hover:bg-gray-200 transition-all duration-300">
                                        Ver Itinerario
                                    </a>
                                )}
                                <a href={tour.link} target="_blank" rel="noopener noreferrer" class="w-full inline-flex items-center justify-center px-4 py-3 bg-primary text-white text-sm font-bold rounded-xl hover:bg-red-700 transition-all duration-300">
                                    Consultar Ahora
                                    <i class="fab fa-whatsapp ml-2 text-lg" aria-hidden="true" />
                                </a>
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
